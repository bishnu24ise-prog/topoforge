{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://topoforge-backend.onrender.com/api/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
